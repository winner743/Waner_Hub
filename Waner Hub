            if bypassAntiCheat and typeof(self) == "Instance" then
                if key == "WalkSpeed" or key == "JumpPower" or key == "Health" then
                    return oldNewIndex(self, key, value)
                end
            end
            return oldNewIndex(self, key, value)
        end)
