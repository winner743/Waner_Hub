local rainbowConn = nil
local function StartRainbow()
    if rainbowConn then return end
    State.RainbowEnabled = true
    local hue = 0
    rainbowConn = RunService.RenderStepped:Connect(function(dt)
        if not State.RainbowEnabled then return end
        hue = (hue + dt * 0.15) % 1
        local c = Color3.fromHSV(hue, 0.8, 1)
        State.Theme.Primary = c
        State.Theme.ToggleOn = c
        if State.MainFrame then
            local stroke = State.MainFrame:FindFirstChildOfClass("UIStroke")
            if stroke then stroke.Color = c end
        end
        if State.ScreenGui then
            for _, obj in ipairs(State.ScreenGui:GetDescendants()) do
                if obj:IsA("TextButton") and obj.Name == "ToggleBtn" then
                    obj.BackgroundColor3 = c
                end
            end
        end
    end)
end

local function StopRainbow()
    State.RainbowEnabled = false
    if rainbowConn then
        rainbowConn:Disconnect()
        rainbowConn = nil
    end
end

