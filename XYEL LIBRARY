local function SetupMusic()
    if State.Music.Sound and State.Music.Sound.Parent then return end
    State.Music.Sound = Create("Sound", {
        Name = "XYEL_Music",
        Volume = State.Music.Volume,
        Looped = State.Music.Looped,
        Playing = false,
        Parent = SoundService,
    })
end

local function PlayMusic()
    SetupMusic()
    if State.Music.SoundId == "" then
        XYEL:Notify({ Title = "Music", Content = T("MusicNotSet"), Type = "warning" })
        return false
    end
    local ok = pcall(function()
        State.Music.Sound.SoundId = "rbxassetid://" .. State.Music.SoundId
        State.Music.Sound.Volume = State.Music.Volume
        State.Music.Sound.Looped = State.Music.Looped
        State.Music.Sound:Play()
    end)
    if ok then
        State.Music.Playing = true
        return true
    end
    return false
end

local function StopMusic()
    if State.Music.Sound then
        pcall(function() State.Music.Sound:Stop() end)
    end
    State.Music.Playing = false
end

