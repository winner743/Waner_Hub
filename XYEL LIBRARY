                RegI18n(lbl, textKey)
                local selBtn = Create("TextButton", {
                    Size = UDim2.new(0, 100, 0, 28), Position = UDim2.new(1, -110, 0, 7),
                    BackgroundColor3 = State.Theme.Background,
                    Text = tostring(selected), TextColor3 = State.Theme.Text,
                    Font = Enum.Font.Gotham, TextSize = 12,
                    AutoButtonColor = false, Parent = container,
                })
                Corner(selBtn, 8)
                Stroke(selBtn, State.Theme.Primary, 1, 0.7)
                local listFrame = Create("Frame", {
                    Size = UDim2.new(1, -20, 0, 0), Position = UDim2.new(0, 10, 0, 46),
                    BackgroundTransparency = 1, Parent = container,
                })
                Create("UIListLayout", {
                    Padding = UDim.new(0, 4),
                    SortOrder = Enum.SortOrder.LayoutOrder, Parent = listFrame,
                })
                for _, opt in ipairs(options) do
                    local optBtn = Create("TextButton", {
                        Size = UDim2.new(1, 0, 0, 28),
                        BackgroundColor3 = State.Theme.Background,
                        Text = tostring(opt), TextColor3 = State.Theme.TextDim,
                        Font = Enum.Font.Gotham, TextSize = 12,
                        AutoButtonColor = false, Parent = listFrame,
                    })
                    Corner(optBtn, 6)
                    optBtn.MouseEnter:Connect(function()
                        Tween(optBtn, 0.15, { BackgroundColor3 = State.Theme.Primary, TextColor3 = State.Theme.Text })
                    end)
                    optBtn.MouseLeave:Connect(function()
                        Tween(optBtn, 0.15, { BackgroundColor3 = State.Theme.Background, TextColor3 = State.Theme.TextDim })
                    end)
                    optBtn.MouseButton1Click:Connect(function()
                        selected = opt
                        selBtn.Text = tostring(opt)
                        open = false
                        Tween(container, 0.3, { Size = UDim2.new(1, 0, 0, 42) }, Enum.EasingStyle.Quint)
                        if callback then callback(opt) end
                    end)
                end
                selBtn.MouseButton1Click:Connect(function()
                    open = not open
                    local totalH = 42 + (#options * 32) + 14
                    Tween(container, 0.3, { Size = UDim2.new(1, 0, 0, open and totalH or 42) }, Enum.EasingStyle.Quint)
                end)
                return {
                    Set = function(v) selected = v; selBtn.Text = tostring(v) end,
                    Get = function() return selected end,
                    Frame = container, Label = lbl,
                }
            end
            return SectionObj
        end
        WindowObj._tabs[nameKey] = TabObj
        return TabObj
    end
    
    -- Default tabs
    if not noDefaultTabs then
        local InfoTab = WindowObj:CreateTab("Info")
        local InfoSec = InfoTab:CreateSection("Info")
        InfoSec:CreateButton("Copy", function()
            if setclipboard then setclipboard(discord) end
            XYEL:Notify({ Title = "Discord", Content = T("Copied"), Type = "success" })
        end)
        local SettingsTab = WindowObj:CreateTab("Settings")
        local AppearanceSec = SettingsTab:CreateSection("Appearance")
        AppearanceSec:CreateDropdown("Language", LanguageList, CurrentLang, function(v)
            CurrentLang = v
            State.Language = v
            RefreshI18n()
            XYEL:Notify({ Title = "Language", Content = "✓ " .. v, Type = "info", Duration = 2 })
        end)
        AppearanceSec:CreateDropdown("MenuMode", { "Normal Mode", "Floating Mode" }, "Normal Mode", function(v)
            State.MenuMode = v
            XYEL:Notify({ Title = "Menu Mode", Content = T("ModeChanged"), Type = "info", Duration = 2 })
        end)
    end
    
    local ToggleBtn = Create("TextButton", {
        Name = "ToggleBtn",
        Size = UDim2.new(0, 56, 0, 56), Position = UDim2.new(0, 24, 0.5, -28),
        BackgroundColor3 = State.Theme.Primary, Text = "X",
        TextColor3 = Color3.fromRGB(255,255,255),
        Font = Enum.Font.GothamBold, TextSize = 22,
        AutoButtonColor = false, ZIndex = 50, Parent = ScreenGui,
    })
    Corner(ToggleBtn, 28)
    local toggleStroke = Stroke(ToggleBtn, Color3.fromRGB(255,255,255), 1.5, 0.4)
    Gradient(ToggleBtn, State.Theme.Primary, Color3.fromRGB(255, 100, 180), 45)
    
    local menuOpen = true
    ToggleBtn.MouseButton1Click:Connect(function()
        menuOpen = not menuOpen
        MainFrame.Visible = menuOpen
        ToggleBtn.Text = menuOpen and "X" or "≡"
    end)
    CloseBtn.MouseButton1Click:Connect(function()
        menuOpen = false
        MainFrame.Visible = false
        ToggleBtn.Text = "≡"
    end)
    MinBtn.MouseButton1Click:Connect(function()
        menuOpen = false
        MainFrame.Visible = false
        ToggleBtn.Text = "≡"
    end)
    
    ShowLoading(ScreenGui, baseTitle, function()
        MainFrame.Visible = true
        menuOpen = true
        TitleLbl.Text = baseTitle .. " - " .. State.GameName
        task.wait(0.2)
        for _, cb in ipairs(WindowObj._readyCallbacks) do
            local ok, err = pcall(cb)
            if not ok then warn("[XYEL] OnReady error: " .. tostring(err)) end
        end
        task.delay(1, function()
            XYEL:Notify({
                Title = "XYEL HUB", Content = State.GameName,
                Type = "success", Duration = 3,
            })
        end)
    end)
    
    return WindowObj
end

function XYEL:SetLanguage(lang)
    CurrentLang = lang
    State.Language = lang
    RefreshI18n()
end
function XYEL:GetLanguage() return CurrentLang end
function XYEL:GetLanguages() return LanguageList end
function XYEL:GetGameName() return State.GameName end
function XYEL:DestroyAll()
    pcall(function()
        local p = GetParent()
        if p:FindFirstChild("XYEL_HUB_Library") then
            p.XYEL_HUB_Library:Destroy()
        end
    end)
end

return XYEL
