-- LIBRARY API
-- ═══════════════════════════════════════════════════════
function XYEL:SetLanguage(lang)
    CurrentLang = lang
    State.Language = lang
    RefreshI18n()
end
function XYEL:GetLanguage() return CurrentLang end
function XYEL:GetLanguages()
    local list = {}
    for k in pairs(Translations) do table.insert(list, k) end
    return list
end
function XYEL:SetThemeColor(c) State.Theme.Primary = c end
function XYEL:GetTheme() return State.Theme end
function XYEL:SetMusic(soundId, volume)
    State.Music.SoundId = tostring(soundId)
    if volume then State.Music.Volume = volume end
end
function XYEL:PlayMusic() return PlayMenuMusic() end
function XYEL:StopMusic() StopMenuMusic() end
function XYEL:ServerHop() DoServerHop() end
function XYEL:SmallServer() DoSmallServer() end
function XYEL:Rejoin() DoRejoin() end
function XYEL:DestroyAll()
    for _, w in ipairs(State.Windows) do
        pcall(function() w:Destroy() end)
    end
    State.Windows = {}
    pcall(function() UnmuteGameMusic() end)
    pcall(function() MusicPlayer:Destroy() end)
    pcall(function()
        local p = GetParent()
        for _, name in ipairs({"XYEL_HUB_Library", "XYEL_HUB", "XYEL_LOADING"}) do
            if p:FindFirstChild(name) then p[name]:Destroy() end
        end
    end)
end

