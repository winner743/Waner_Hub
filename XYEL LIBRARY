                end
                toggleBg.MouseButton1Click:Connect(function() setState(not state) end)
                return { Set = setState, Get = function() return state end, Frame = row, Label = lbl }
            end
            function SectionObj:CreateSlider(textKey, min, max, default, callback)
                min = min or 0; max = max or 100; default = default or min
                local value = default
                local row = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 62),
                    BackgroundColor3 = State.Theme.Surface, Parent = page,
