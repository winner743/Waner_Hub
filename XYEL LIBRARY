                    BackgroundColor3 = State.Theme.Background,
                    BorderSizePixel = 0, Parent = row,
                })
                Corner(barBg, 4)
                local fill = Create("Frame", {
                    Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
                    BackgroundColor3 = State.Theme.Primary,
                    BorderSizePixel = 0, Parent = barBg,
                })
                Corner(fill, 4)
                local knob = Create("Frame", {
                    Size = UDim2.new(0, 16, 0, 16),
                    Position = UDim2.new((default - min) / (max - min), -8, 0.5, -8),
                    BackgroundColor3 = Color3.fromRGB(255,255,255),
                    BorderSizePixel = 0, Parent = barBg,
                })
                Corner(knob, 8)
                Stroke(knob, State.Theme.Primary, 2, 0)
                local function updateFromInput(input)
                    local pos = math.clamp((input.Position.X - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X, 0, 1)
                    value = math.floor(min + (max - min) * pos)
                    valueLabel.Text = tostring(value)
                    Tween(fill, 0.05, { Size = UDim2.new(pos, 0, 1, 0) })
                    Tween(knob, 0.05, { Position = UDim2.new(pos, -8, 0.5, -8) })
                    if callback then callback(value) end
                end
                barBg.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                        State.SliderActive = updateFromInput
                        updateFromInput(input)
                    end
                end)
                return {
                    Set = function(v)
                        value = math.clamp(v, min, max)
                        local pos = (value - min) / (max - min)
                        valueLabel.Text = tostring(value)
                        Tween(fill, 0.1, { Size = UDim2.new(pos, 0, 1, 0) })
                        Tween(knob, 0.1, { Position = UDim2.new(pos, -8, 0.5, -8) })
                        if callback then callback(value) end
                    end,
                    Get = function() return value end,
                    Frame = row, Label = lbl,
                }
            end
            function SectionObj:CreateDropdown(textKey, options, default, callback)
