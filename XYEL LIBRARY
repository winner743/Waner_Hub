                    -- Create floating for each tab
                    for tabName, tabPage in pairs(WindowObj._tabData) do
                        local container = Create("Frame", { BackgroundTransparency = 1 })
                        CreateFloatingWindow(ScreenGui, tabName, container, tabName)
                        tabPage.Parent = container
                        tabPage.Size = UDim2.new(1, 0, 1, 0)
                        tabPage.Position = UDim2.new(0, 0, 0, 0)
                        tabPage.Visible = true
                        tabPage.ScrollBarThickness = 3
                    end
                    ToggleBtn.Text = "X"
                    menuOpen = true
                end)
            else
                for tabName, tabPage in pairs(WindowObj._tabData) do
                    local container = Create("Frame", { BackgroundTransparency = 1 })
                    CreateFloatingWindow(ScreenGui, tabName, container, tabName)
                    tabPage.Parent = container
                    tabPage.Size = UDim2.new(1, 0, 1, 0)
                    tabPage.Position = UDim2.new(0, 0, 0, 0)
                    tabPage.Visible = true
                    tabPage.ScrollBarThickness = 3
                end
                ToggleBtn.Text = "X"
                menuOpen = true
            end
        else
            -- Close floating
            for _, fw in ipairs(State.FloatingWindows) do
                if fw and fw.Parent then fw.Visible = false end
            end
            -- Restore pages to main Content
            for tabName, tabPage in pairs(WindowObj._tabData) do
                tabPage.Parent = Content
                tabPage.Size = UDim2.new(1, -20, 1, -20)
                tabPage.Position = UDim2.new(0, 10, 0, 10)
                tabPage.Visible = false
            end
            -- Show active tab
            if activeTab and WindowObj._tabData[activeTab] then
                WindowObj._tabData[activeTab].Visible = true
            end
            -- Open with anim
            OpenMenuAnim(MainFrame, UDim2.new(0.5, -320, 0.5, -210), UDim2.new(0, 640, 0, 420))
            ToggleBtn.Text = "X"
            menuOpen = true
        end
    end
    
    -- Toggle button click
    ToggleBtn.MouseButton1Click:Connect(function()
        if State.MenuMode == "Floating Mode" then
            menuOpen = not menuOpen
            for _, fw in ipairs(State.FloatingWindows) do
                if fw and fw.Parent then
                    fw.Visible = menuOpen
                end
            end
            Tween(ToggleBtn, 0.3, { Rotation = menuOpen and 0 or 180 }, ANIM.Bounce)
            ToggleBtn.Text = menuOpen and "X" or "≡"
        else
            if menuOpen then
                -- Close
                CloseMenuAnim(MainFrame, function()
                    menuOpen = false
                    Tween(ToggleBtn, 0.3, { BackgroundColor3 = State.Theme.Success, Rotation = 180 }, ANIM.Bounce)
                    ToggleBtn.Text = "≡"
                end)
                menuOpen = false
                Tween(ToggleBtn, 0.3, { BackgroundColor3 = State.Theme.Success, Rotation = 180 }, ANIM.Bounce)
                ToggleBtn.Text = "≡"
            else
                -- Open
                OpenMenuAnim(MainFrame, UDim2.new(0.5, -320, 0.5, -210), UDim2.new(0, 640, 0, 420))
                Tween(ToggleBtn, 0.3, { BackgroundColor3 = State.Theme.Primary, Rotation = 0 }, ANIM.Bounce)
                ToggleBtn.Text = "X"
                menuOpen = true
            end
        end
    end)
    
    CloseBtn.MouseButton1Click:Connect(function()
        if State.MenuMode == "Floating Mode" then
            for _, fw in ipairs(State.FloatingWindows) do
                if fw and fw.Parent then fw.Visible = false end
            end
        else
            CloseMenuAnim(MainFrame, function()
                menuOpen = false
                Tween(ToggleBtn, 0.3, { BackgroundColor3 = State.Theme.Success, Rotation = 180 }, ANIM.Bounce)
                ToggleBtn.Text = "≡"
            end)
        end
    end)
    
    MinBtn.MouseButton1Click:Connect(function()
        if State.MenuMode == "Floating Mode" then
            for _, fw in ipairs(State.FloatingWindows) do
                if fw and fw.Parent then fw.Visible = false end
            end
        else
            CloseMenuAnim(MainFrame, function()
                menuOpen = false
                Tween(ToggleBtn, 0.3, { BackgroundColor3 = State.Theme.Success, Rotation = 180 }, ANIM.Bounce)
                ToggleBtn.Text = "≡"
            end)
        end
    end)
    
    -- ═══ SHOW LOADING + FIRE OnReady ═══
    ShowLoading(ScreenGui, baseTitle, function()
        MainFrame.Visible = true
        menuOpen = true
        TitleLbl.Text = baseTitle .. " - " .. State.GameName
        
        -- Open animation
        OpenMenuAnim(MainFrame, UDim2.new(0.5, -320, 0.5, -210), UDim2.new(0, 640, 0, 420))
        
        task.wait(0.3)
        for _, cb in ipairs(WindowObj._readyCallbacks) do
            local ok, err = pcall(cb)
            if not ok then warn("[XYEL] OnReady error: " .. tostring(err)) end
        end
        
        task.delay(1.5, function()
            XYEL:Notify({
                Title = "XYEL HUB",
                Content = State.GameName,
                Type = "success",
                Duration = 3,
            })
        end)
    end)
    
    return WindowObj
end

function XYEL:SetLanguage(lang)
    CurrentLang = lang
    State.Language = lang
    RefreshI18n()
end
function XYEL:GetLanguage() return CurrentLang end
function XYEL:GetLanguages() return LanguageList end
function XYEL:GetGameName() return State.GameName end
function XYEL:DestroyAll()
    StopRainbow()
    StopMusic()
    pcall(function()
        local p = GetParent()
        if p:FindFirstChild("XYEL_HUB_Library") then
            p.XYEL_HUB_Library:Destroy()
        end
    end)
end

return XYEL
