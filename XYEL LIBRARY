    -- ═══ DEFAULT TABS (Info & Settings only, no Main) ═══
    if not noDefaultTabs then
        -- INFO TAB
        local InfoTab = WindowObj:CreateTab("Info")
        local InfoSection = InfoTab:CreateSection("Info")
