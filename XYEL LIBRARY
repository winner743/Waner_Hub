        waveConn:Disconnect()
        
        Tween(Loading, 0.6, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quint)
        Tween(glow, 0.5, { BackgroundTransparency = 1 })
        Tween(ringContainer, 0.5, { Size = UDim2.new(0, 300, 0, 300), Position = UDim2.new(0.5, -150, 0.4, -300) })
        for _, child in ipairs(Loading:GetChildren()) do
            if child:IsA("TextLabel") then
                Tween(child, 0.5, { TextTransparency = 1 })
            elseif child:IsA("Frame") then
                Tween(child, 0.5, { BackgroundTransparency = 1 })
            end
        end
        task.wait(0.65)
        if Loading then Loading:Destroy() end
        if callback then callback() end
    end)
end

