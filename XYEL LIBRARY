    -- Toggle Button
    local ToggleBtn = Create("TextButton", {
        Name = "ToggleBtn",
        Size = UDim2.new(0, 56, 0, 56),
        Position = UDim2.new(0, 24, 0.5, -28),
        BackgroundColor3 = State.Theme.Primary,
        Text = "X",
        TextColor3 = Color3.fromRGB(255,255,255),
        Font = Enum.Font.GothamBold,
        TextSize = 22,
        AutoButtonColor = false,
        ZIndex = 50,
        Parent = ScreenGui,
    })
    Corner(ToggleBtn, 28)
    local toggleStroke = Stroke(ToggleBtn, Color3.fromRGB(255,255,255), 1.5, 0.4)
    Gradient(ToggleBtn, State.Theme.Primary, Color3.fromRGB(255, 100, 180), 45)
    
    task.spawn(function()
        while ToggleBtn.Parent do
            Tween(toggleStroke, 1.2, { Transparency = 0.7, Thickness = 2.5 })
            task.wait(1.2)
            Tween(toggleStroke, 1.2, { Transparency = 0.4, Thickness = 1.5 })
            task.wait(1.2)
        end
    end)
    
    local tbDragging, tbStart, tbStartPos
    ToggleBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            tbDragging = true
            tbStart = input.Position
            tbStartPos = ToggleBtn.Position
        end
    end)
    ToggleBtn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            tbDragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if tbDragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - tbStart
            ToggleBtn.Position = UDim2.new(
                tbStartPos.X.Scale, tbStartPos.X.Offset + delta.X,
                tbStartPos.Y.Scale, tbStartPos.Y.Offset + delta.Y
            )
        end
    end)
    
    local menuOpen = true
    
    local function OpenMenu()
        if menuOpen then return end
        menuOpen = true
        MainFrame.Visible = true
        if State.Animations then
            MainFrame.Size = UDim2.new(0, 0, 0, 0)
            MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
            MainFrame.BackgroundTransparency = 1
            Tween(MainFrame, 0.4, { Size = UDim2.new(0, 640, 0, 420), Position = UDim2.new(0.5, -320, 0.5, -210), BackgroundTransparency = 0 }, Enum.EasingStyle.Back)
            task.wait(0.05)
            Tween(mainStroke, 0.3, { Transparency = 0.5 })
        end
        Tween(ToggleBtn, 0.3, { BackgroundColor3 = State.Theme.Primary, Rotation = 0 }, Enum.EasingStyle.Back)
        ToggleBtn.Text = "X"
        
        if State.Music.MuteGameOnOpen ~= false then
            MuteGameMusic()
        end
        if State.Music.AutoPlay ~= false and State.Music.SoundId ~= "" then
            ResumeMenuMusic()
        end
    end
    
    local function CloseMenu()
        if not menuOpen then return end
        menuOpen = false
        if State.Animations then
            Tween(mainStroke, 0.2, { Transparency = 1 })
            local t = Tween(MainFrame, 0.3, { Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 0.5, 0), BackgroundTransparency = 1 }, Enum.EasingStyle.Quint)
            t.Completed:Connect(function()
                if not menuOpen then MainFrame.Visible = false end
            end)
        else
            MainFrame.Visible = false
        end
        Tween(ToggleBtn, 0.3, { BackgroundColor3 = State.Theme.Success, Rotation = 180 }, Enum.EasingStyle.Back)
        ToggleBtn.Text = "≡"
        
        UnmuteGameMusic()
        PauseMenuMusic()
    end
    
    local tbPressPos
    ToggleBtn.MouseButton1Down:Connect(function()
        tbPressPos = UserInputService:GetMouseLocation()
    end)
    ToggleBtn.MouseButton1Click:Connect(function()
        local cur = UserInputService:GetMouseLocation()
        if tbPressPos and (cur - tbPressPos).Magnitude < 8 then
            if menuOpen then CloseMenu() else OpenMenu() end
        end
    end)
    
    CloseBtn.MouseButton1Click:Connect(CloseMenu)
    MinBtn.MouseButton1Click:Connect(CloseMenu)
    
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == State.ToggleKey then
            if menuOpen then CloseMenu() else OpenMenu() end
        end
    end)
    
    -- Show loading
    local ready = false
    task.delay(1.5, function() ready = true end)
    
    ShowLoading(ScreenGui, title, function() return ready end, function()
        MainFrame.Visible = true
        menuOpen = true
        if State.Animations then
            MainFrame.Size = UDim2.new(0, 0, 0, 0)
            MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
            MainFrame.BackgroundTransparency = 1
            Tween(MainFrame, 0.5, { Size = UDim2.new(0, 640, 0, 420), Position = UDim2.new(0.5, -320, 0.5, -210), BackgroundTransparency = 0 }, Enum.EasingStyle.Back)
        end
        if State.Music.MuteGameOnOpen ~= false then
            MuteGameMusic()
        end
        if State.Music.AutoPlay ~= false and State.Music.SoundId ~= "" then
            PlayMenuMusic()
        end
    end)
    
    task.delay(3, function()
        XYEL:Notify({
            Title = "XYEL HUB",
            Content = "Script loaded successfully! ✓",
            Type = "success",
            Duration = 3,
        })
    end)
    
    table.insert(State.Windows, WindowObj)
    return WindowObj
end

