local ANIM = {
    Smooth = Enum.EasingStyle.Quint,
    Bounce = Enum.EasingStyle.Back,
    Elastic = Enum.EasingStyle.Elastic,
    Spring = Enum.EasingStyle.Quad,
    Linear = Enum.EasingStyle.Linear,
}

-- ═══ ULTRA OPEN ANIMATION ═══
local function OpenMenuAnim(frame, centerPos, targetSize)
    if not frame then return end
    
    frame.Visible = true
    frame.Size = UDim2.new(0, 0, 0, 0)
    frame.Position = UDim2.new(0.5, 0, 0.5, 0)
    frame.BackgroundTransparency = 1
    
    -- Hide children first
    for _, child in ipairs(frame:GetDescendants()) do
        if child:IsA("GuiObject") then
            if not child:GetAttribute("NoAnim") then
                child.BackgroundTransparency = 1
                if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
                    child.TextTransparency = 1
                end
            end
        end
    end
    
    task.wait(0.02)
    
    -- Main frame elastic pop
    Tween(frame, 0.65, {
        Size = targetSize,
        Position = centerPos,
        BackgroundTransparency = 0,
    }, ANIM.Elastic)
    
    -- Children fade in with stagger
    task.spawn(function()
        local delay = 0
        for _, child in ipairs(frame:GetDescendants()) do
            if child:IsA("GuiObject") and not child:GetAttribute("NoAnim") then
                task.delay(delay, function()
                    if child and child.Parent then
                        Tween(child, 0.35, { BackgroundTransparency = 0 }, ANIM.Smooth)
                        if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
                            Tween(child, 0.4, { TextTransparency = 0 }, ANIM.Smooth)
                        end
                    end
                end)
                delay = delay + 0.006
            end
        end
    end)
end

-- ═══ ULTRA CLOSE ANIMATION ═══
local function CloseMenuAnim(frame, onComplete)
    if not frame then return end
    
    -- Children fade fast
    for _, child in ipairs(frame:GetDescendants()) do
        if child:IsA("GuiObject") then
            Tween(child, 0.18, { BackgroundTransparency = 1 }, ANIM.Smooth)
            if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
                Tween(child, 0.18, { TextTransparency = 1 }, ANIM.Smooth)
            end
        end
    end
    
    task.wait(0.1)
    
    -- Main frame suck in
    local t = Tween(frame, 0.35, {
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        BackgroundTransparency = 1,
    }, ANIM.Smooth)
    
    t.Completed:Connect(function()
        frame.Visible = false
        if onComplete then onComplete() end
    end)
end

-- ═══ DRAG ═══
local function MakeDraggable(frame, handle)
    local dragging, dragStart, startPos
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)
    handle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

-- ═══ GLOBAL SLIDER ═══
UserInputService.InputChanged:Connect(function(input)
    if not State.SliderActive then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        State.SliderActive(input)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        State.SliderActive = nil
    end
end)

