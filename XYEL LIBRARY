    local function CreateTabButton(nameKey, callback)
        local btn = Create("TextButton", {
            Size = UDim2.new(1, 0, 0, 34),
            BackgroundColor3 = State.Theme.Background,
            BackgroundTransparency = 0.5, Text = "",
            AutoButtonColor = false, ZIndex = 6, Parent = TabList,
        })
        Corner(btn, 8)
        local label = Create("TextLabel", {
            Size = UDim2.new(1, -32, 1, 0), Position = UDim2.new(0, 26, 0, 0),
            BackgroundTransparency = 1, Text = T(nameKey),
            TextColor3 = State.Theme.TextDim,
            Font = Enum.Font.GothamMedium, TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 7, Parent = btn,
        })
        RegI18n(label, nameKey)
        local indicator = Create("Frame", {
            Size = UDim2.new(0, 3, 0.6, 0), Position = UDim2.new(0, 6, 0.2, 0),
            BackgroundColor3 = State.Theme.Primary,
            BorderSizePixel = 0, BackgroundTransparency = 1,
            ZIndex = 8, Parent = btn,
        })
        Corner(indicator, 2)
        btn.MouseEnter:Connect(function()
            if activeTab ~= nameKey then
                Tween(btn, 0.2, { BackgroundTransparency = 0.3 })
                Tween(label, 0.2, { TextColor3 = State.Theme.Text })
            end
        end)
        btn.MouseLeave:Connect(function()
            if activeTab ~= nameKey then
                Tween(btn, 0.2, { BackgroundTransparency = 0.5 })
                Tween(label, 0.2, { TextColor3 = State.Theme.TextDim })
            end
        end)
        btn.MouseButton1Click:Connect(function()
            if activeTab == nameKey then return end
            activeTab = nameKey
            for n, data in pairs(tabButtons) do
                Tween(data.btn, 0.2, { BackgroundTransparency = 0.5 })
                Tween(data.label, 0.2, { TextColor3 = State.Theme.TextDim })
                Tween(data.indicator, 0.2, { BackgroundTransparency = 1 })
            end
            Tween(btn, 0.2, { BackgroundTransparency = 0 })
            Tween(label, 0.2, { TextColor3 = State.Theme.Text })
            Tween(indicator, 0.2, { BackgroundTransparency = 0 })
            if callback then callback() end
        end)
        tabButtons[nameKey] = { btn = btn, label = label, indicator = indicator }
        return btn
    end
    
    function WindowObj:CreateTab(nameKey)
        local page = Create("ScrollingFrame", {
            Size = UDim2.new(1, -20, 1, -20), Position = UDim2.new(0, 10, 0, 10),
