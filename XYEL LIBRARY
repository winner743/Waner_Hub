        end)
        
        musicSection:CreateButton("Apply", function()
            if State.Music.SoundId == "" then
                XYEL:Notify({ Title = "Music", Content = T("MusicNotSet"), Type = "warning" })
                return
            end
            StopMenuMusic()
            if PlayMenuMusic() then
                XYEL:Notify({ Title = "Music", Content = T("SoundApplied"), Type = "success" })
            else
                XYEL:Notify({ Title = "Music", Content = T("InvalidSound"), Type = "error" })
            end
        end)
        
