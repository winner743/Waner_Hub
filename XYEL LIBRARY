local MusicPlayer = Create("Sound", {
    Name = "XYEL_MusicPlayer",
    SoundId = "",
    Volume = 0.5,
    Looped = true,
    Playing = false,
    Parent = SoundService,
})

local gameMusicRestoreState = {}

local function MuteGameMusic()
    if State.GameMusicMuted then return end
    State.GameMusicMuted = true
    gameMusicRestoreState = {}
    
    pcall(function()
        for _, child in ipairs(SoundService:GetDescendants()) do
            if child:IsA("Sound") and child ~= MusicPlayer and child.Playing then
                gameMusicRestoreState[child] = { Volume = child.Volume, WasPlaying = child.Playing }
                child.Volume = 0
            end
        end
    end)
    
    pcall(function()
        for _, sg in ipairs(SoundService:GetChildren()) do
            if sg:IsA("SoundGroup") then
                gameMusicRestoreState[sg] = { Volume = sg.Volume }
                sg.Volume = 0
            end
        end
    end)
end

local function UnmuteGameMusic()
    if not State.GameMusicMuted then return end
    State.GameMusicMuted = false
    
    for obj, state in pairs(gameMusicRestoreState) do
        pcall(function()
            if obj and obj.Parent then
                if state.Volume then obj.Volume = state.Volume end
            end
        end)
    end
    gameMusicRestoreState = {}
end

local function PlayMenuMusic()
    if not State.Music.Enabled then return false end
    if not State.Music.SoundId or State.Music.SoundId == "" then return false end
    
    local ok = pcall(function()
        MusicPlayer.SoundId = "rbxassetid://" .. State.Music.SoundId
        MusicPlayer.Volume = State.Music.Volume
        MusicPlayer.Looped = State.Music.Looped
        MusicPlayer:Play()
    end)
    
    if ok then
        State.Music.Playing = true
        return true
    end
    return false
end

local function StopMenuMusic()
    pcall(function() MusicPlayer:Stop() end)
    State.Music.Playing = false
end

local function PauseMenuMusic()
    pcall(function() MusicPlayer:Pause() end)
    State.Music.Playing = false
end

local function ResumeMenuMusic()
    if State.Music.Enabled and State.Music.SoundId ~= "" then
        pcall(function()
            MusicPlayer.SoundId = "rbxassetid://" .. State.Music.SoundId
            MusicPlayer.Volume = State.Music.Volume
            MusicPlayer.Looped = State.Music.Looped
            MusicPlayer:Resume()
        end)
        State.Music.Playing = true
    end
end

