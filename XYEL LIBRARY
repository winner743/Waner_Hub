local i18nElements = {}

local function RegI18n(obj, key, isPlaceholder)
    table.insert(i18nElements, {
        obj = obj,
        key = key,
        isPlaceholder = isPlaceholder or false,
    })
end

local function RefreshI18n()
    for _, item in ipairs(i18nElements) do
        if item.obj and item.obj.Parent then
            if item.isPlaceholder then
                item.obj.PlaceholderText = T(item.key)
            else
                item.obj.Text = T(item.key)
            end
        end
    end
end

