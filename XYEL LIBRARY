-- SERVER ACTIONS (REAL WORKING)
-- ═══════════════════════════════════════════════════════
local function FetchServers()
    local servers = {}
    local cursor = ""
    local ok = pcall(function()
        for _ = 1, 3 do  -- Fetch 3 pages max
            local url = "https://games.roblox.com/v1/games/" .. game.PlaceId ..
                "/servers/Public?sortOrder=Asc&limit=100"
            if cursor ~= "" then
                url = url .. "&cursor=" .. cursor
            end
            
            local response = HttpService:JSONDecode(game:HttpGet(url))
            if response and response.data then
                for _, srv in ipairs(response.data) do
                    if srv.id and srv.playing and srv.maxPlayers then
                        table.insert(servers, srv)
                    end
                end
                cursor = response.nextPageCursor or ""
                if cursor == "" then break end
            else
                break
            end
        end
    end)
    return servers
end

local function DoServerHop()
    task.spawn(function()
        local servers = FetchServers()
        if #servers == 0 then
            XYEL:Notify({ Title = "Server Hop", Content = T("NoServerFound"), Type = "error" })
            return
        end
        
        -- Pick random server
        local target = servers[math.random(1, #servers)]
        local attempts = 0
        while target.id == game.JobId and attempts < 10 do
            target = servers[math.random(1, #servers)]
            attempts = attempts + 1
        end
        
        if target and target.id ~= game.JobId then
            pcall(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, target.id, LocalPlayer)
            end)
        else
            XYEL:Notify({ Title = "Server Hop", Content = T("NoServerFound"), Type = "warning" })
        end
    end)
end

local function DoSmallServer()
    task.spawn(function()
        local servers = FetchServers()
        if #servers == 0 then
            XYEL:Notify({ Title = T("SmallServerBtn"), Content = T("NoServerFound"), Type = "error" })
            return
        end
        
        -- Find server with fewest players (excluding self)
        local best, bestCount = nil, math.huge
        for _, srv in ipairs(servers) do
            if srv.id ~= game.JobId and srv.playing < bestCount then
                bestCount = srv.playing
                best = srv
            end
        end
        
        if best then
            pcall(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, best.id, LocalPlayer)
            end)
        else
            XYEL:Notify({ Title = T("SmallServerBtn"), Content = T("AlreadyIn"), Type = "warning" })
        end
    end)
end

local function DoRejoin()
    task.spawn(function()
        local ok = pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
        end)
        if not ok then
            -- Fallback to Teleport
            pcall(function()
                TeleportService:Teleport(game.PlaceId, LocalPlayer)
            end)
        end
    end)
end

