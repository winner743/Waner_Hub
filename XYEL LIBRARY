-- Detect game name
local function DetectGameName()
    local ok, name = pcall(function()
        local info = MarketplaceService:GetProductInfo(game.PlaceId, Enum.InfoType.Asset)
        return info.Name
    end)
    if ok and name and name ~= "" then return name end
    if game.Name and game.Name ~= "" then return game.Name end
    return "Game " .. tostring(game.PlaceId)
end

-- Notify
local notifStack = 0
function XYEL:Notify(opts)
    opts = opts or {}
    local parent = GetParent():FindFirstChild("XYEL_HUB_Library")
    if not parent then return end
    local title = opts.Title or "Notification"
    local content = opts.Content or ""
    local duration = opts.Duration or 3
    local ntype = opts.Type or "info"
    local colors = {
        info = State.Theme.Primary, success = State.Theme.Success,
        warning = State.Theme.Warning, error = State.Theme.Danger,
    }
    local accentColor = colors[ntype] or colors.info
    notifStack = notifStack + 1
    local myIndex = notifStack
    local baseY = 20 + (myIndex - 1) * 82
    local notif = Create("Frame", {
        Size = UDim2.new(0, 320, 0, 72),
        Position = UDim2.new(1, 20, 0, baseY),
        BackgroundColor3 = State.Theme.Surface,
        BorderSizePixel = 0, ZIndex = 500, Parent = parent,
    })
    Corner(notif, 12)
    Stroke(notif, accentColor, 1.5, 0.4)
    Create("Frame", {
        Size = UDim2.new(0, 4, 1, -20), Position = UDim2.new(0, 8, 0, 10),
        BackgroundColor3 = accentColor, BorderSizePixel = 0, Parent = notif,
    })
    Create("TextLabel", {
        Size = UDim2.new(1, -40, 0, 22), Position = UDim2.new(0, 22, 0, 12),
        BackgroundTransparency = 1, Text = title,
        TextColor3 = State.Theme.Text, Font = Enum.Font.GothamBold,
        TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, Parent = notif,
    })
    Create("TextLabel", {
        Size = UDim2.new(1, -40, 0, 32), Position = UDim2.new(0, 22, 0, 32),
        BackgroundTransparency = 1, Text = content,
        TextColor3 = State.Theme.TextDim, Font = Enum.Font.Gotham,
        TextSize = 12, TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top, Parent = notif,
    })
    Tween(notif, 0.4, { Position = UDim2.new(1, -340, 0, baseY) }, Enum.EasingStyle.Back)
    task.spawn(function()
        task.wait(duration)
        Tween(notif, 0.35, { Position = UDim2.new(1, 20, 0, baseY), BackgroundTransparency = 1 })
        task.wait(0.35)
        if notif and notif.Parent then notif:Destroy() end
        notifStack = math.max(0, notifStack - 1)
    end)
end

-- Loading Screen (waits for game)
local function ShowLoading(parent, title, callback)
    local Loading = Create("Frame", {
        Name = "XYEL_LOADING", Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Color3.fromRGB(0, 0, 0),
        BorderSizePixel = 0, ZIndex = 1000, Parent = parent,
    })
    Create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 60), Position = UDim2.new(0, 0, 0.4, -60),
        BackgroundTransparency = 1, Text = title or "XYEL HUB",
        TextColor3 = Color3.fromRGB(255, 255, 255),
        Font = Enum.Font.GothamBold, TextSize = 48, ZIndex = 1001, Parent = Loading,
    })
    local StatusLbl = Create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 24), Position = UDim2.new(0, 0, 0.4, 10),
        BackgroundTransparency = 1, Text = T("LoadingGame"),
        TextColor3 = Color3.fromRGB(180, 180, 190),
        Font = Enum.Font.Gotham, TextSize = 16, ZIndex = 1001, Parent = Loading,
    })
    local Wave = Create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 0.4, 40),
        BackgroundTransparency = 1,
        Text = "_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_",
        TextColor3 = State.Theme.Primary,
        Font = Enum.Font.Code, TextSize = 14, ZIndex = 1001, Parent = Loading,
    })
    local Percent = Create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 0.4, 70),
        BackgroundTransparency = 1, Text = "0%",
        TextColor3 = Color3.fromRGB(255, 255, 255),
        Font = Enum.Font.GothamBold, TextSize = 14, ZIndex = 1001, Parent = Loading,
    })
    local waveOffset = 0
    local conn = RunService.RenderStepped:Connect(function(dt)
        waveOffset = waveOffset + dt * 8
        local pattern = ""
        for i = 1, 32 do
            local idx = math.floor((i + waveOffset) % 4)
            pattern = pattern .. (idx < 2 and "_" or "-")
        end
        if Wave and Wave.Parent then Wave.Text = pattern end
    end)
    local progress = 0
    task.spawn(function()
        while progress < 60 do
            progress = math.min(60, progress + math.random(2, 5))
            if Percent and Percent.Parent then Percent.Text = tostring(progress) .. "%" end
            task.wait(0.05)
        end
        if StatusLbl and StatusLbl.Parent then StatusLbl.Text = T("DetectingGame") end
        State.GameName = DetectGameName()
        while progress < 90 do
            progress = math.min(90, progress + math.random(1, 3))
            if Percent and Percent.Parent then Percent.Text = tostring(progress) .. "%" end
            task.wait(0.05)
        end
        local maxWait = tick() + 15
        while tick() < maxWait do
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                if StatusLbl and StatusLbl.Parent then
                    StatusLbl.Text = State.GameName
                    StatusLbl.TextColor3 = State.Theme.Primary
                end
                break
            end
            task.wait(0.3)
        end
        while progress < 100 do
            progress = math.min(100, progress + math.random(3, 6))
            if Percent and Percent.Parent then Percent.Text = tostring(progress) .. "%" end
            task.wait(0.03)
        end
        task.wait(0.5)
        conn:Disconnect()
        Tween(Loading, 0.6, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quint)
        for _, child in ipairs(Loading:GetChildren()) do
            if child:IsA("TextLabel") then Tween(child, 0.5, { TextTransparency = 1 }) end
        end
        task.wait(0.65)
        Loading:Destroy()
        if callback then callback() end
    end)
end

